<?xml version="1.0" encoding="utf-8"?>
<!-- Quick add widget: the owl, a box to type in, and a microphone. Tap to log something or ask, straight from the home screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kq_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:background="@drawable/widget_quick_bg">
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/kw_owl"
        android:contentDescription="KeepWise owl" />
    <!-- looks like a text box (Android widgets can't hold a real one); a tap opens the owl with the keyboard up -->
    <TextView
        android:id="@+id/kq_field"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:background="@drawable/widget_field_bg"
        android:text="@string/quick_field"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#6B7F77"
        android:textSize="14sp" />
    <ImageView
        android:id="@+id/kq_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="11dp"
        android:background="@drawable/widget_mic_bg"
        android:src="@drawable/ic_kw_mic"
        android:contentDescription="@string/quick_mic" />
</LinearLayout>

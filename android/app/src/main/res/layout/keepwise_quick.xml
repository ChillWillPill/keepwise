<?xml version="1.0" encoding="utf-8"?>
<!-- Quick add widget: the owl, "Add spending", and a microphone. Tap to log something or ask, straight from the home screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kq_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:background="@drawable/widget_quick_bg">
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/kw_owl"
        android:contentDescription="KeepWise owl" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_title"
            android:maxLines="1"
            android:textColor="#10231C"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_hint"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#4A5E56"
            android:textSize="12sp" />
    </LinearLayout>
    <ImageView
        android:id="@+id/kq_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="11dp"
        android:background="@drawable/widget_mic_bg"
        android:src="@drawable/ic_kw_mic"
        android:contentDescription="@string/quick_mic" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Quick add widget: the owl, a box to type in, and a microphone. Tap to log something or ask, straight from the home screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kq_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="@drawable/widget_quick_bg">
    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/kw_owl"
        android:contentDescription="KeepWise owl" />
    <!-- looks like a text box (Android widgets can't hold a real one); a tap opens the owl with the keyboard up -->
    <TextView
        android:id="@+id/kq_field"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:background="@drawable/widget_field_bg"
        android:text="@string/quick_field"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#6B7F77"
        android:textSize="14sp" />
    <ImageView
        android:id="@+id/kq_mic"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="10dp"
        android:background="@drawable/widget_mic_bg"
        android:src="@drawable/ic_kw_mic"
        android:contentDescription="@string/quick_mic" />
    </LinearLayout>
    <!-- the owl's last answer (or a tip until you've asked something) -->
    <TextView
        android:id="@+id/kq_said"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="@drawable/widget_said_bg"
        android:text="@string/quick_tip"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#10231C"
        android:textSize="12sp" />
</LinearLayout>

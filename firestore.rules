rules_version = '2';
// Keepwise: each signed-in person can read and change only their own profile. Web push keeps only a push address and nudge dates.
service cloud.firestore {
  match /databases/{database}/documents {
    // The owner's Google account can read every profile for the admin dashboard. It cannot change them.
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'notartist04@gmail.com'
        && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    // Web push: a device's push address and the dates of its next nudges. Anyone may add or remove their own;
    // nobody can read them from the app. Only the sender, with its own key, reads them.
    match /push/{token} {
      allow read: if false;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['token','dates','tz','at','uid'])
        && (!('uid' in request.resource.data) || (request.auth != null && request.resource.data.uid == request.auth.uid))
        && request.resource.data.token == token && token.size() < 400
        && request.resource.data.dates is list && request.resource.data.dates.size() <= 6
        && request.resource.data.tz is string && request.resource.data.tz.size() < 60;
    }
    // Friends on KeepWise: find/{code}, where code is SHA-256 of "keepwise:" + your verified email. Only you can write
    // your own code (the rules work it out from your sign-in), anyone signed in can look one up, nobody can list them.
    match /find/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.token.email_verified == true
        && code == hashing.sha256('keepwise:' + request.auth.token.email.lower()).toHexString().lower()
        && request.resource.data.keys().hasOnly(['uid','at']) && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // A split a friend sent you: they write it as themselves, only you read and remove it.
    match /inbox/{uid}/items/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['fromUid','from','email','kind','ref','title','total','owe','text','at'])
        && request.resource.data.fromUid == request.auth.uid && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.kind in ['add','edit','delete','settle']
        && request.resource.data.text is string && request.resource.data.text.size() <= 600
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.from is string && request.resource.data.from.size() <= 40;
    }
    // A nudge to send a push notification ("Sam shared a split with you"). Only the sender script reads these.
    match /ping/{id} {
      allow read, update, delete: if false;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['uid','from','at'])
        && request.resource.data.uid is string && request.resource.data.from is string && request.resource.data.from.size() <= 40;
    }
    // Sync across devices: a sealed copy only the owner's devices can open (end-to-end encrypted on the phone).
    match /users/{uid}/sync/{doc} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && doc == 'state'
        && request.resource.data.keys().hasOnly(['v','salt','iv','data','z','at','dev'])
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
    }
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isOwner();
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','dob','phone','phoneVerified','city','marketing','marketingUpdatedAt','email','emailVerified','updatedAt','createdAt','termsAcceptedAt','termsVersion','provider','photo','location','plusInterest','plusInterestAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && (!('photo' in request.resource.data) || request.resource.data.photo == null || request.resource.data.photo.size() < 200000);
    }
  }
}
